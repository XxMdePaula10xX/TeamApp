{
  "name": "pelada-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gestor de times amadores de futebol — artilharia, assistências e aproveitamento.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
