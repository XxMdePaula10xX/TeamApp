rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Regras do Firebase Storage — Pelada Manager
//
// Logos de times e fotos de jogadores são públicos para leitura.
// Upload exige usuário autenticado e arquivo de imagem até 5 MB.
// A checagem fina de "é o dono do time" fica nas regras do
// Firestore (o caminho aqui só restringe a autenticados).
// ─────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Logos: teams/{teamId}/logo.*
    match /teams/{teamId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isImageUnder5MB();
    }

    // Fotos de jogadores: players/{teamId}/{playerId}.*
    match /players/{teamId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && isImageUnder5MB();
    }

    // Avatares de usuário: users/{userId}.*
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && isImageUnder5MB();
    }
  }
}
