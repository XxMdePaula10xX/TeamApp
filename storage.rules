rules_version = '2';

// ─────────────────────────────────────────────────────────────
// Regras do Firebase Storage — Pelada Manager
//
// Imagens (logos, fotos) são públicas para leitura. O UPLOAD é
// prefixado pelo uid do dono no próprio caminho — assim um usuário não
// sobrescreve a logo do time de outro (defacement), já que a leitura é
// pública. Storage não consegue consultar o Firestore para checar
// ownership, então a segurança vem do path por uid + tamanho/tipo.
// ─────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Logos de time: teams/{uid}/{teamId}/{fileName}
    match /teams/{uid}/{teamId}/{fileName} {
      allow read: if true;
      allow write: if isSelf(uid) && isImageUnder5MB();
    }

    // Fotos de jogador: players/{uid}/{teamId}/{fileName}
    match /players/{uid}/{teamId}/{fileName} {
      allow read: if true;
      allow write: if isSelf(uid) && isImageUnder5MB();
    }

    // Avatares de usuário: users/{uid}/{fileName}
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSelf(uid) && isImageUnder5MB();
    }
  }
}
