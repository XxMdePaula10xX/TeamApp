# ─────────────────────────────────────────────────────────────
# Firebase Web SDK config — Pelada Manager
# Copie este arquivo para `.env` e preencha com as credenciais do
# seu projeto Firebase (Console > Configurações do projeto > Geral >
# Seus apps > App da Web > SDK setup and configuration).
#
# Todas as variáveis expostas ao client DEVEM começar com VITE_.
# NÃO commite o arquivo `.env` com credenciais reais.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Opcional (Google Analytics):
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Opcional: base dos links compartilhaveis (deep links). Defina com o
# dominio do seu deploy (ex.: https://pelada-manager.web.app) para que o
# botao Compartilhar gere URLs reais tambem no app nativo. Sem isso, usa
# a origem atual do navegador.
VITE_PUBLIC_BASE_URL=
